    "start:dispatch": "node task-1-dispatch/src/server.ts",
    "start:booking": "node task-2-booking/src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
